# Routes the @nikolasd scope to the private npm registry that @nikolasd/batman
# and its platform binary leaf packages (@nikolasd/batman-<platform>) are
# published to. Replace the URL below with your organization's actual
# private registry before publishing or installing.
@nikolasd:registry=https://npm.private-registry.internal/
//npm.private-registry.internal/:_authToken=${NPM_TOKEN}
