# Routes the @satori scope to the private npm registry that @satori/batman
# and its platform binary leaf packages (@satori/batman-<platform>) are
# published to. Replace the URL below with your organization's actual
# private registry before publishing or installing.
@satori:registry=https://npm.private-registry.internal/
//npm.private-registry.internal/:_authToken=${SATORI_NPM_TOKEN}
