.superpowers/
# OMP agent configuration (per-repo, machine-local) — never committed.
.omp/
node_modules/
target/
dist/
!packages/extension/dist/
!packages/extension/dist/index.js

.DS_Store

# ts-rs `#[ts(export)]` writes here as a `cargo test` side effect; Task 3's
# xtask owns the real export destination and invocation.
crates/protocol/bindings/

# `batman-xtask package` writes bin/batcave and manifest.json into each
# platform leaf directory; they are release build staging, created on
# demand, and never committed to source control.
packages/batman-*/

# Generated fresh by release.yml on every run and uploaded as a CI artifact;
# never committed to source control.
release/release-manifest.json

# Agent working plans/specs (superpowers skill) — ephemeral scratch docs,
# never permanent project documentation.
docs/superpowers/
