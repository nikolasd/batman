{
  "name": "@satori/batman-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "generate": "cargo run -p batman-xtask -- generate",
    "build": "bun run --cwd packages/extension build",
    "test": "bun test packages && cargo test --workspace",
    "check": "bun run generate --check && bun run build && bun test packages && cargo test --workspace"
  }
}
