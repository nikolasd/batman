{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolDocument",
  "description": "Root schema document referencing every exported request/result/event\ntype, so that a single `schemars` invocation produces one JSON Schema\nwith everything reachable from the wire protocol in `$defs`.",
  "type": "object",
  "properties": {
    "eventEnvelope": {
      "$ref": "#/$defs/EventEnvelope"
    },
    "initializeParams": {
      "$ref": "#/$defs/InitializeParams"
    },
    "initializeResult": {
      "$ref": "#/$defs/InitializeResult"
    },
    "jsonRpcErrorResponse": {
      "$ref": "#/$defs/JsonRpcErrorResponse"
    },
    "jsonRpcNotification": {
      "$ref": "#/$defs/JsonRpcNotification"
    },
    "jsonRpcRequest": {
      "$ref": "#/$defs/JsonRpcRequest"
    },
    "jsonRpcResponse": {
      "$ref": "#/$defs/JsonRpcResponse"
    },
    "runtimeEvent": {
      "$ref": "#/$defs/RuntimeEvent"
    },
    "runtimeStatus": {
      "$ref": "#/$defs/RuntimeStatus"
    }
  },
  "required": [
    "initializeParams",
    "initializeResult",
    "eventEnvelope",
    "runtimeEvent",
    "jsonRpcRequest",
    "jsonRpcResponse",
    "jsonRpcErrorResponse",
    "jsonRpcNotification",
    "runtimeStatus"
  ],
  "$defs": {
    "ApprovalId": {
      "description": "Identifies an approval request raised by the runtime.",
      "type": "string"
    },
    "BatmanMethod": {
      "description": "All JSON-RPC methods implemented by the BATMAN runtime, including\norchestration extension methods.\n\nSerialized as the literal method name string used on the wire.",
      "type": "string",
      "enum": [
        "initialize",
        "runtime/status",
        "events/subscribe",
        "events/replay",
        "runtime/shutdown",
        "task/upsert",
        "task/get",
        "worker/create",
        "worker/list",
        "worker/get",
        "run/submit",
        "run/list",
        "run/get",
        "run/retry",
        "run/cancel",
        "message/send",
        "message/list",
        "approval/list",
        "approval/decide",
        "coordination/child/list",
        "coordination/child/decide",
        "coordination/task",
        "coordination/peers",
        "coordination/send",
        "coordination/requestChild",
        "coordination/publishArtifact",
        "coordination/reportBlocked",
        "coordination/askPolicy",
        "reconcile/omp"
      ]
    },
    "BinarySource": {
      "description": "Where the running `batcave` binary was loaded from. `override` means a\ndeveloper override path, `package` a bundled/installed binary, and\n`unknown` that the source could not be determined.",
      "type": "string",
      "enum": [
        "override",
        "package",
        "unknown"
      ]
    },
    "ClientAuth": {
      "description": "Authentication payload presented by a connecting client. The `role` tag\ndetermines which shape the remaining fields take.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "agentDirectory": {
              "type": "string"
            },
            "instanceId": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "const": "ompExtension"
            }
          },
          "additionalProperties": false,
          "required": [
            "role",
            "instanceId",
            "agentDirectory"
          ]
        },
        {
          "type": "object",
          "properties": {
            "instanceId": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "const": "workerMcp"
            },
            "scopeToken": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "role",
            "instanceId",
            "scopeToken"
          ]
        },
        {
          "type": "object",
          "properties": {
            "instanceId": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "const": "display"
            }
          },
          "additionalProperties": false,
          "required": [
            "role",
            "instanceId"
          ]
        }
      ]
    },
    "ClientCapabilities": {
      "description": "Capabilities a connecting client declares support for.",
      "type": "object",
      "properties": {
        "eventReplay": {
          "type": "boolean"
        },
        "maxFrameBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "eventReplay",
        "maxFrameBytes"
      ]
    },
    "ClientInfo": {
      "description": "Identifies the connecting client implementation (name + version), for\ndiagnostics only.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "ClientPrincipalSummary": {
      "description": "A summary of the authenticated client, echoed back so the client can\nconfirm how the runtime identified it.",
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClientRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "instanceId"
      ]
    },
    "ClientRole": {
      "description": "The role a connecting client authenticates as.",
      "type": "string",
      "enum": [
        "ompExtension",
        "workerMcp",
        "display"
      ]
    },
    "DiagnosticLevel": {
      "description": "The severity of a [`RuntimeEvent::Diagnostic`].",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "EventEnvelope": {
      "description": "The envelope wrapping every durable runtime event, carrying its sequence\nnumber and routing metadata.",
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/RuntimeEvent"
        },
        "parentWorkerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "runId": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/EventSource"
        },
        "taskId": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        },
        "vendorEventRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "workerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkerId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "sequence",
        "timestamp",
        "projectId",
        "source",
        "event"
      ]
    },
    "EventSource": {
      "description": "Identifies which subsystem produced an event.",
      "type": "string",
      "enum": [
        "runtime"
      ]
    },
    "InitializeParams": {
      "description": "Parameters for the `initialize` request.",
      "type": "object",
      "properties": {
        "auth": {
          "$ref": "#/$defs/ClientAuth"
        },
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities"
        },
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "lastSequence": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "supported": {
          "$ref": "#/$defs/VersionRange"
        }
      },
      "additionalProperties": false,
      "required": [
        "client",
        "supported",
        "repository",
        "auth",
        "capabilities"
      ]
    },
    "InitializeResult": {
      "description": "Result of a successful `initialize` request.",
      "type": "object",
      "properties": {
        "allowedMethods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BatmanMethod"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/RuntimeCapabilities"
        },
        "negotiated": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "nextSequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "principal": {
          "$ref": "#/$defs/ClientPrincipalSummary"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeInfo"
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime",
        "negotiated",
        "projectId",
        "principal",
        "allowedMethods",
        "capabilities",
        "nextSequence"
      ]
    },
    "JsonRpcError": {
      "description": "A JSON-RPC 2.0 error object. `data` carries optional, already-sanitized\ndiagnostic detail; it is omitted from the wire form when absent.",
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "JsonRpcErrorResponse": {
      "description": "A JSON-RPC 2.0 error response envelope. `id` is `None` when the request\nidentifier could not be determined (for example, on a parse error).",
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/JsonRpcError"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "error"
      ]
    },
    "JsonRpcNotification": {
      "description": "A JSON-RPC 2.0 notification envelope: a method call with no `id`, for\nwhich no response is expected. BATMAN uses these to push runtime events to\nsubscribed clients via the `events/event` method.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method"
      ]
    },
    "JsonRpcRequest": {
      "description": "A JSON-RPC 2.0 request envelope.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method"
      ]
    },
    "JsonRpcResponse": {
      "description": "A JSON-RPC 2.0 success response envelope.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "type": "string"
        },
        "result": true
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    "MessageId": {
      "description": "Identifies a single message within a run's transcript.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Identifies a repository/project managed by the BATMAN runtime.",
      "type": "string"
    },
    "ProtocolVersion": {
      "description": "A BATMAN protocol version, expressed as `major.minor` with no patch\ncomponent (patch-level changes must be backward compatible).",
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "RepositoryIdentity": {
      "description": "Identifies a repository on disk, independent of any particular runtime\ninstance.",
      "type": "object",
      "properties": {
        "canonicalPath": {
          "type": "string"
        },
        "vcsRoot": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "canonicalPath",
        "vcsRoot"
      ]
    },
    "RequestId": {
      "description": "A JSON-RPC request identifier, either a number or a string.",
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        }
      ]
    },
    "RunFlags": {
      "description": "Independent boolean flags on a run.\n\n`degradedControl`, `needsReconciliation`, `protocolUnhealthy`,\n`policyQuarantined`, `workspaceDirty`, and `childrenActive` are all\nindependent booleans.",
      "type": "object",
      "properties": {
        "childrenActive": {
          "type": "boolean"
        },
        "degradedControl": {
          "type": "boolean"
        },
        "needsReconciliation": {
          "type": "boolean"
        },
        "policyQuarantined": {
          "type": "boolean"
        },
        "protocolUnhealthy": {
          "type": "boolean"
        },
        "workspaceDirty": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "degradedControl",
        "needsReconciliation",
        "protocolUnhealthy",
        "policyQuarantined",
        "workspaceDirty",
        "childrenActive"
      ]
    },
    "RunId": {
      "description": "Identifies a single run of a task.",
      "type": "string"
    },
    "RuntimeCapabilities": {
      "description": "Capabilities the runtime grants for the negotiated session.",
      "type": "object",
      "properties": {
        "maxFrameBytes": {
          "description": "The negotiated maximum NDJSON frame size, in bytes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "peerCredentialsVerified": {
          "description": "Whether the runtime was able to verify the peer's OS credentials for\nthis connection. `false` on platforms where peer credential lookup is\nunavailable.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "maxFrameBytes",
        "peerCredentialsVerified"
      ]
    },
    "RuntimeEvent": {
      "description": "A sanitized, durable runtime event. Fields are plain, already-sanitized\ntypes (never [`Classified`]) so that raw thinking/secret content can\nnever reach the durable log through this type.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runtimeStarted"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runtimeStopping"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "level": {
                  "$ref": "#/$defs/DiagnosticLevel"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "level",
                "code",
                "message"
              ]
            },
            "type": {
              "type": "string",
              "const": "diagnostic"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "A task was created or updated via `task/upsert`.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "kind": {
                  "$ref": "#/$defs/RuntimeEventKind"
                },
                "ownerClientInstanceId": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "taskId": {
                  "$ref": "#/$defs/TaskId"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "taskId",
                "ownerClientInstanceId",
                "revision"
              ]
            },
            "type": {
              "type": "string",
              "const": "taskEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "A worker was created via `worker/create`.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "kind": {
                  "$ref": "#/$defs/RuntimeEventKind"
                },
                "profileId": {
                  "type": "string"
                },
                "workerId": {
                  "$ref": "#/$defs/WorkerId"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "workerId",
                "profileId"
              ]
            },
            "type": {
              "type": "string",
              "const": "workerEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "A run entered a new lifecycle state.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "kind": {
                  "$ref": "#/$defs/RuntimeEventKind"
                },
                "runId": {
                  "$ref": "#/$defs/RunId"
                },
                "state": {
                  "type": "string"
                },
                "taskId": {
                  "$ref": "#/$defs/TaskId"
                },
                "workerId": {
                  "$ref": "#/$defs/WorkerId"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "runId",
                "taskId",
                "workerId",
                "state"
              ]
            },
            "type": {
              "type": "string",
              "const": "runEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "Flags on a run were changed.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "flags": {
                  "$ref": "#/$defs/RunFlags"
                },
                "runId": {
                  "$ref": "#/$defs/RunId"
                }
              },
              "additionalProperties": false,
              "required": [
                "runId",
                "flags"
              ]
            },
            "type": {
              "type": "string",
              "const": "runFlagsEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "A message was recorded, sent, acknowledged, or failed.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "deliveryState": {
                  "type": "string"
                },
                "kind": {
                  "$ref": "#/$defs/RuntimeEventKind"
                },
                "messageId": {
                  "$ref": "#/$defs/MessageId"
                },
                "runId": {
                  "$ref": "#/$defs/RunId"
                },
                "taskId": {
                  "$ref": "#/$defs/TaskId"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "messageId",
                "runId",
                "taskId",
                "deliveryState"
              ]
            },
            "type": {
              "type": "string",
              "const": "messageEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "An approval request was created.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "approvalId": {
                  "$ref": "#/$defs/ApprovalId"
                },
                "kind": {
                  "$ref": "#/$defs/RuntimeEventKind"
                },
                "runId": {
                  "$ref": "#/$defs/RunId"
                },
                "taskId": {
                  "$ref": "#/$defs/TaskId"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "approvalId",
                "runId",
                "taskId",
                "action"
              ]
            },
            "type": {
              "type": "string",
              "const": "approvalEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "A child worker was requested or denied.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "childRunId": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/RunId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "childTaskId": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/TaskId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "childWorkerId": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/WorkerId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "kind": {
                  "$ref": "#/$defs/RuntimeEventKind"
                },
                "parentRunId": {
                  "$ref": "#/$defs/RunId"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "parentRunId"
              ]
            },
            "type": {
              "type": "string",
              "const": "childEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        },
        {
          "description": "Ownership of a task was rebound via `reconcile/omp`.",
          "type": "object",
          "properties": {
            "payload": {
              "type": "object",
              "properties": {
                "newOwnerClientInstanceId": {
                  "type": "string"
                },
                "oldOwnerClientInstanceId": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "taskId": {
                  "$ref": "#/$defs/TaskId"
                }
              },
              "additionalProperties": false,
              "required": [
                "taskId",
                "oldOwnerClientInstanceId",
                "newOwnerClientInstanceId",
                "revision"
              ]
            },
            "type": {
              "type": "string",
              "const": "reconcileEvent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "payload"
          ]
        }
      ]
    },
    "RuntimeEventKind": {
      "description": "The semantic kind of an orchestration event stored in the durable journal.\n\nEvery record creation, lifecycle transition, flag change, message delivery\nchange, and approval request/decision produces one of these variants.",
      "type": "string",
      "enum": [
        "taskCreated",
        "taskUpdated",
        "workerCreated",
        "runQueued",
        "runStarting",
        "runWorking",
        "runWaitingUser",
        "runWaitingPeer",
        "runPaused",
        "runSucceeded",
        "runFailed",
        "runCancelled",
        "runLost",
        "runFlagsChanged",
        "messageRecorded",
        "messageSent",
        "messageAcknowledged",
        "messageFailed",
        "approvalRequested",
        "approvalDecided",
        "childWorkerRequested",
        "childWorkerRequestDenied",
        "reconcileOwnershipChanged"
      ]
    },
    "RuntimeInfo": {
      "description": "Identifies the runtime implementation (name + version), for diagnostics\nonly.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "RuntimeStatus": {
      "description": "Result of a `runtime/status` request: a snapshot of the runtime's health\nand identity. Kept intentionally small at foundation scope; later tasks\nextend it with richer run/queue detail.",
      "type": "object",
      "properties": {
        "activeRuns": {
          "description": "Number of active runs. Always `0` at foundation scope.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "binarySource": {
          "description": "Where the running binary was loaded from.",
          "$ref": "#/$defs/BinarySource"
        },
        "projectId": {
          "description": "The canonical project id this runtime serves.",
          "$ref": "#/$defs/ProjectId"
        },
        "protocol": {
          "description": "The protocol version the runtime negotiated for this session.",
          "$ref": "#/$defs/ProtocolVersion"
        },
        "protocolHealthy": {
          "description": "Whether the negotiated protocol is within the runtime's supported\nrange (a self-check that always holds for a live, negotiated session).",
          "type": "boolean"
        },
        "running": {
          "description": "Whether the runtime is accepting connections and serving requests.",
          "type": "boolean"
        },
        "schemaVersion": {
          "description": "The durable database schema version currently applied.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "uptimeSeconds": {
          "description": "Seconds the runtime has been up since it started serving.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "running",
        "protocol",
        "projectId",
        "activeRuns",
        "schemaVersion",
        "protocolHealthy",
        "uptimeSeconds",
        "binarySource"
      ]
    },
    "TaskId": {
      "description": "Identifies a task tracked by the runtime.",
      "type": "string"
    },
    "Timestamp": {
      "description": "Canonical UTC RFC 3339 timestamp text, as carried on the wire.\n\nRather than expose [`time::OffsetDateTime`] across generated bindings,\nBATMAN normalizes every timestamp to a UTC RFC 3339 string at\nconstruction time; downstream consumers (including schemars/ts-rs) only\never see a plain string.",
      "type": "string"
    },
    "VersionRange": {
      "description": "An inclusive range of protocol versions a client (or runtime) supports.",
      "type": "object",
      "properties": {
        "max": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "min": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "WorkerId": {
      "description": "Identifies a worker process spawned by the runtime.",
      "type": "string"
    }
  }
}
